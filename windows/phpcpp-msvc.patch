diff --git a/include/visibility.h b/include/visibility.h
index afb8a6b..002b0b5 100644
--- a/include/visibility.h
+++ b/include/visibility.h
@@ -28,3 +28,19 @@
 #else
     #define PHPCPP_EXPORT __attribute__ ((visibility ("default")))
 #endif
+
+/**
+ *  Calling convention of the functions the Zend engine calls (zif_handler).
+ *  Mirrors ZEND_FASTCALL in Zend/zend_portability.h, which the public headers
+ *  cannot include: on Windows x64 that is __vectorcall, and a handler declared
+ *  without it does not even convert to zif_handler under MSVC.
+ */
+#if defined(__GNUC__) && defined(__i386__)
+    #define PHPCPP_FASTCALL __attribute__((fastcall))
+#elif defined(_MSC_VER) && defined(_M_IX86) && _MSC_VER == 1700
+    #define PHPCPP_FASTCALL __fastcall
+#elif defined(_MSC_VER) && _MSC_VER >= 1800
+    #define PHPCPP_FASTCALL __vectorcall
+#else
+    #define PHPCPP_FASTCALL
+#endif
