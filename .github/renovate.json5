// Renovate, run by the configs repo's .github/workflows/renovate.yml as the organisation's GitHub App, so the
// PRs get CI. The PHP releases of the Windows build: the PHP_8.x_GTK3 runtimes take their PHP release
// from this workflow's artifact name, so a PHP patch release reaches them only once the matrix moves.
// Also the WebView2 SDK of that build, and the GitHub Actions (weekly, in one PR).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":semanticCommits"],
  timezone: "UTC",
  // PHP patch releases are mostly security releases: any day, as soon as they are out.
  schedule: ["at any time"],
  prHourlyLimit: 0,
  enabledManagers: ["custom.regex", "github-actions"],
  customDatasources: {
    // windows.php.net's index of the newest release of each minor. The version comes from the zip's name,
    // which carries the "-N" of a Windows rebuild (8.4.27-1) that "version" leaves out.
    "php-windows": {
      defaultRegistryUrlTemplate: "https://downloads.php.net/~windows/releases/releases.json",
      format: "json",
      transformTemplates: [
        '{"releases": [$each($, function($v) { $v.*[$contains(zip.path, /^php-[0-9.]+(-[0-9]+)?-nts-Win32-vs[0-9]+-x64\\.zip$/)].{"version": $match(zip.path, /^php-([0-9.]+(?:-[0-9]+)?)-nts-/).groups[0], "releaseTimestamp": mtime} })]}',
      ],
    },
  },
  customManagers: [
    {
      // The PHP-CPP headers codechecks.yml analyses against: a commit of our fork's default branch (master),
      // the one windows.yml builds from unpinned. A commit has no release date and this config sets no
      // minimum release age, so no rule is needed for that.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/codechecks\\.yml$/"],
      matchStrings: ["git clone (?<packageName>https://github\\.com/APS-Services/PHP-CPP)\\.git [^\\n]+\\n\\s+git -C [^ ]+ checkout (?<currentDigest>[0-9a-f]{40})"],
      depNameTemplate: "APS-Services/PHP-CPP",
      currentValueTemplate: "master",
      datasourceTemplate: "git-refs",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/windows\\.yml$/"],
      matchStrings: ['- php: "(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-\\d+)?)"'],
      depNameTemplate: "php-windows",
      datasourceTemplate: "custom.php-windows",
      // build: a Windows rebuild of the same source (8.4.27 -> 8.4.27-1) is newer, not a pre-release
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-(?<build>\\d+))?$",
    },
    {
      // The WebView2 SDK the Windows build compiles php_gtk3.dll's WebView against (windows.yml env).
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/windows\\.yml$/"],
      matchStrings: ["WEBVIEW2_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "Microsoft.Web.WebView2",
      datasourceTemplate: "nuget",
      // NuGet versioning reads a bare version as "this or newer", so it would never propose one; four
      // numbers only, so the SDK's "-prerelease" builds are not versions at all
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
    },
  ],
  packageRules: [
    {
      // Each matrix line stays on its minor: a new minor is a new runtime repository, not an update.
      matchDatasources: ["custom.php-windows"],
      separateMinorPatch: true,
    },
    {
      matchDatasources: ["custom.php-windows"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      schedule: ["before 7am on monday"],
    },
    {
      // The headers' pin: weekly is enough, the build itself always takes the fork's newest commit.
      matchDepNames: ["APS-Services/PHP-CPP"],
      schedule: ["before 7am on monday"],
    },
    {
      // The runner images stay where they are: codechecks.yml needs 24.04 (26.04 has no libgladeui-dev).
      matchDatasources: ["github-runners"],
      enabled: false,
    },
  ],
}
